CREATE UNIQUE INDEX IF NOT EXISTS base_units_id_uidx ON base_units(id);
CREATE UNIQUE INDEX IF NOT EXISTS units_id_uidx ON units(id);
CREATE UNIQUE INDEX IF NOT EXISTS params_type_id_uidx ON params_type(id);
CREATE UNIQUE INDEX IF NOT EXISTS employees_id_uidx ON employees(id);
CREATE UNIQUE INDEX IF NOT EXISTS measurment_baths_id_uidx ON measurment_baths(id);
CREATE UNIQUE INDEX IF NOT EXISTS measurment_input_params_id_uidx ON measurment_input_params(id);

-- Базовые единицы
INSERT INTO base_units (id, name) VALUES
  (1, 'Метр'),
  (2, 'Градус Цельсия'),
  (3, 'Миллиметр ртутного столба'),
  (4, 'Градус'),
  (5, 'Метр в секунду')
ON CONFLICT (id) DO UPDATE SET
  name = EXCLUDED.name;

-- Единицы измерения
INSERT INTO units (id, base_unit_id, name) VALUES
  (1, 1, 'м'),
  (2, 2, '°C'),
  (3, 3, 'мм рт.ст.'),
  (4, 4, '°'),
  (5, 5, 'м/с')
ON CONFLICT (id) DO UPDATE SET
  base_unit_id = EXCLUDED.base_unit_id,
  name = EXCLUDED.name;

-- Типы параметров.
-- У params_type id=4 намеренно НЕВЕРНАЯ единица: unit_id=5 (м/с) вместо 4 (°).
INSERT INTO params_type (id, unit_id, name) VALUES
  (1, 1, 'Высота'),
  (2, 2, 'Температура'),
  (3, 3, 'Давление'),
  (4, 5, 'Направление'),  -- аномалия: неверная единица измерения
  (5, 5, 'Скорость')
ON CONFLICT (id) DO UPDATE SET
  unit_id = EXCLUDED.unit_id,
  name = EXCLUDED.name;

