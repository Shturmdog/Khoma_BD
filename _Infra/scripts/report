-- Список параметров с ошибками
with bath_parameters as (
    select
        measurment_bath_id,
        max(case when parameter_type_id = 1 then measurment_value end) as height,
        max(case when parameter_type_id = 2 then measurment_value end) as temperature,
        max(case when parameter_type_id = 3 then measurment_value end) as pressure,
        max(case when parameter_type_id = 4 then measurment_value end) as wind_direction,
        max(case when parameter_type_id = 5 then measurment_value end) as wind_speed,
        max(case when parameter_type_id = 6 then measurment_value end) as bullet_drift
    from measurment_input_params
    group by measurment_bath_id
),
validation_results as (
    select 
        bp.measurment_bath_id,
        mt.short_name as equipment_type,
        bp.height, bp.temperature, bp.pressure,
        bp.wind_direction, bp.wind_speed, bp.bullet_drift,
        fn_validate_meteo(
            row(
                mt.short_name,
                bp.height, bp.temperature, bp.pressure,
                bp.wind_direction, bp.wind_speed, bp.bullet_drift
            )::meteo_input_parms
        ) as error_description
    from bath_parameters bp
    join measurment_baths mb on mb.id = bp.measurment_bath_id
    join measurment_types mt on mt.id = mb.measurment_type_id
)
select
    row_number() over (order by measurment_bath_id) as "№",
    equipment_type as "Тип оборудования",
    height as "Высота метеопоста", 
    temperature as "Температура", 
    pressure as "Давление",
    wind_direction as "Направление ветра", 
    wind_speed as "Скорость ветра", 
    bullet_drift as "Дальность сноса пуль",
    case when error_description is null then 'Нет' else 'Да' end as "Флаг: Есть ошибка",
    coalesce(error_description, '') as "Описание ошибки"
from validation_results
order by measurment_bath_id;


-- Лучший стрелок
with bath_parameters as (
    select
        measurment_bath_id,
        max(case when parameter_type_id = 1 then measurment_value end) as height,
        max(case when parameter_type_id = 2 then measurment_value end) as temperature,
        max(case when parameter_type_id = 3 then measurment_value end) as pressure,
        max(case when parameter_type_id = 4 then measurment_value end) as wind_direction,
        max(case when parameter_type_id = 5 then measurment_value end) as wind_speed,
        max(case when parameter_type_id = 6 then measurment_value end) as bullet_drift
    from measurment_input_params
    group by measurment_bath_id
),


validation_results as (
    select 
        mb.employee_id,
        fn_validate_meteo(
            row(
                mt.short_name,
                bp.height, bp.temperature, bp.pressure,
                bp.wind_direction, bp.wind_speed, bp.bullet_drift
            )::meteo_input_parms
        ) as error_description
    from bath_parameters bp
    join measurment_baths mb on mb.id = bp.measurment_bath_id
    join measurment_types mt on mt.id = mb.measurment_type_id
)


select
    e.id as "Код сотрудника",
    e.name as "ФИО",
    coalesce(sum(
        case 
            when vr.error_description is not null 
            then length(vr.error_description) - length(replace(vr.error_description, '.', ''))
            else 0 
        end
    ), 0) as "Допущено ошибок"
from employees e
left join validation_results vr on vr.employee_id = e.id
group by e.id, e.name
order by "Допущено ошибок" asc, e.name asc;