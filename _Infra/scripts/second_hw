-- Миграционный скрипт
-- 2026-09-23
drop table if exists measurment_values;
drop table if exists measurment_baths;
drop table if exists measurment_types;
drop table if exists employees;
drop table if exists military_ranks;
drop table if exists parameter_types;
drop table if exists units;
drop table if exists base_units;

-- 1. Справочник должностей
create table military_ranks
(
	id integer,
	description character varying(255)
);

comment on table military_ranks is 'Справочник должностей';
comment on column military_ranks.id is 'Уникальный код';
comment on column military_ranks.description is 'Описание';

-- Заполняем данные
insert into military_ranks(id, description)
values(1,'Рядовой'),(2,'Лейтенант');

-- 2. Пользователя
create table employees
(
    id integer,
	name text,
	birthday timestamp ,
	military_rank_id integer
);

comment on table employees is 'Пользователи';
comment on column employees.id is 'Уникальный код';
comment on column employees.name is 'Наименование';
comment on column employees.birthday is 'Дата рождения';
comment on column employees.military_rank_id is 'Уникальный код должности';

-- Заполняем данные
insert into employees(id, name, birthday,military_rank_id )  
values(1, 'Воловиков Александр Сергеевич','1978-06-24', 2);

-- 3. Устройства для измерения
create table measurment_types
(
   id integer,
   short_name  character varying(50),
   description text 
);

comment on table measurment_types is 'Измерительное оборудование';
comment on column measurment_types.id is 'Уникальный код';
comment on column measurment_types.short_name is 'Краткое наименование';
comment on column measurment_types.description is 'Описание';

-- Заполняем данные
insert into measurment_types(id, short_name, description)
values(1, 'ДМК', 'Десантный метео комплекс'),
(2,'ВР','Ветровое ружье');

---Базовые единицы измерения
create table base_units
(
    id integer,
    short_name character varying(50),
    description character varying(255)
);

comment on table base_units is 'Справочник базовых единиц измерения';
comment on column base_units.short_name is 'Краткое название';
comment on column base_units.description is 'Описание';

create table units
(
    id integer,
    base_unit_id integer,
    short_name character varying(50),
    full_name character varying(255),
    conversion_factor numeric(20,10) default 1
);

comment on table units is 'Справочник единиц измерения';
comment on column units.id is 'Уникальный код';
comment on column units.base_unit_id is 'Ссылка на базовую единицу измерения';
comment on column units.short_name is 'Краткое обозначение';
comment on column units.full_name is 'Полное наименование';
comment on column units.conversion_factor is 'Коэффициент пересчёта к базовой единице';

create table parameter_types
(
    id integer,
    short_name character varying(50),
    description character varying(255),
    base_unit_id integer,
    default_unit_id integer
);

comment on table parameter_types is 'Справочник типов параметров измерений';
comment on column parameter_types.id is 'Уникальный код';
comment on column parameter_types.short_name is 'Краткое наименование';
comment on column parameter_types.description is 'Описание параметра';
comment on column parameter_types.base_unit_id is 'Ссылка на базовую единицу измерения';
comment on column parameter_types.default_unit_id is 'Ссылка на единицу измерения по умолчанию';

create table measurment_baths
(
	id integer ,
	emploee_id integer,
	measurment_type_id integer,
	started timestamp default now()
);

comment on table measurment_baths is 'Пачки';
comment on column measurment_baths.emploee_id is 'Уникальный код пользователя';
comment on column measurment_baths.measurment_type_id is 'Уникальный код оборудования';
comment on column measurment_baths.started is 'Дата измерения';

create table measurment_values
(
    id integer,
    measurment_bath_id integer,
    parameter_type_id integer,
    unit_id integer,
    value numeric(8,2)
);

comment on table measurment_values is 'Значения параметров измерений';
comment on column measurment_values.id is 'Уникальный код';
comment on column measurment_values.measurment_bath_id is 'Ссылка на пачку измерений';
comment on column measurment_values.parameter_type_id is 'Тип параметра';
comment on column measurment_values.unit_id is 'Единица измерения';
comment on column measurment_values.value is 'Значение параметра';

-- Заполняем данные
insert into base_units(id, short_name, description)
values
    (1, 'Длина',       'Длина/высота'),
    (2, 'Температура', 'Температура'),
    (3, 'Давление',    'Давление'),
    (4, 'Скорость',    'Скорость'),
    (5, 'Угол',        'Угол/направление');

--Единицы измерения
insert into units(id, base_unit_id, short_name, full_name, conversion_factor)
values
    (1, 1, 'м',         'метр',                      1),
    (2, 1, 'см',        'сантиметр',                 0.01),
    (3, 2, '°C',        'градус Цельсия',            1),
    (4, 3, 'Па',        'Паскаль',                   1),
    (5, 3, 'мм рт. ст.','миллиметр ртутного столба', 133.322),
    (6, 4, 'м/с',       'метр в секунду',            1),
    (7, 5, '°',         'градус',                    1);

-- Типы параметров
insert into parameter_types(id, short_name, description, base_unit_id, default_unit_id)
values
    (1, 'height',         'Высота',            1, 1),
    (2, 'temperature',    'Температура',       2, 3),
    (3, 'pressure',       'Давление',          3, 4),
    (4, 'wind_direction', 'Направление ветра', 5, 7),
    (5, 'wind_speed',     'Скорость ветра',    4, 6);

insert into measurment_values(id, measurment_bath_id, parameter_type_id, unit_id, value)
values
    (11, 1, 1, 1, 100.00),   -- высота, м
    (12, 1, 2, 3, 12.00),    -- температура, °C
    (13, 1, 3, 4, 34.00),    -- давление, Па
    (14, 1, 4, 7, 0.20),     -- направление ветра, °
    (15, 1, 5, 6, 45.00);    -- скорость ветра, м/с

insert into measurment_baths(id, emploee_id, measurment_type_id, started)
values(1, 1, 1, '2026-09-01'),(2,1,2, '2026-09-02');

---------------------------------------------------
-- Итоговый запрос
---------------------------------------------------

select
    measurment_baths.started as "Дата измерения",
    measurment_baths.id as "Номер пачки",
    employees.name as "ФИО сотрудника",
    parameter_types.description || ' ' || units.short_name as "Наименование ед. измерения",
    measurment_values.value as "Значение"
from measurment_baths, measurment_values, parameter_types, units, base_units,
     measurment_types, employees, military_ranks
where
        -- Связь пачка - пользователи
        employees.id = measurment_baths.emploee_id
        -- Связь звание - пользователь
    and employees.military_rank_id = military_ranks.id
        -- Связь пачка - тип оборудования
    and measurment_types.id = measurment_baths.measurment_type_id
        -- Связь пачка - значения параметров
    and measurment_values.measurment_bath_id = measurment_baths.id
        -- Связь значение - тип параметра
    and parameter_types.id = measurment_values.parameter_type_id
        -- Связь значение - единица измерения
    and units.id = measurment_values.unit_id
        -- Связь единица измерения - базовая величина
    and base_units.id = units.base_unit_id
order by measurment_baths.id, parameter_types.id;