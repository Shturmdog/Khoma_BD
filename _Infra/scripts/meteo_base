do $$
begin
    alter table measurment_input_params 
    add column if not exists error_message text;

    -- Список параметров
    drop type if exists meteo_input_parms cascade;
    create type meteo_input_parms as (
        equipment_type text,  
        height numeric,       
        temperature numeric,
        pressure numeric,
        wind_dir numeric,
        wind_speed numeric,
        bullet_drift numeric
    );

	

    -- Функция проверки
   begin
   	drop table if exists errors_catalog cascade;
    drop sequence if exists errors_catalog_seq cascade;
    
    create sequence errors_catalog_seq start with 1;
    create table errors_catalog (
        id          integer default nextval('errors_catalog_seq') not null,
        name        character varying(50) not null,
        description character varying(255) not null
    );
    alter sequence errors_catalog_seq owned by errors_catalog.id;
    alter table errors_catalog add constraint pk_errors_catalog primary key (id);

    insert into errors_catalog(id, name, description) values
        (1, 'invalid_equipment', 'Неизвестный тип оборудования (допустимо: ДМК, ВР)'),
        (2, 'empty_height',      'Высота должна быть целым числом'),
        (3, 'temp_out_of_range', 'Температура должна быть от -58 до 58'),
        (4, 'press_out_of_range','Давление должно быть от 500 до 900'),
        (5, 'wind_dir_invalid',  'Направление ветра должно быть целым числом от 0 до 59'),
        (6, 'wind_speed_error',  'Скорость ветра должна быть целым числом от 0 до 15'),
        (7, 'bullet_drift_error','Дальность сноса пуль должна быть целым числом от 0 до 150');

		
	create or replace function fn_validate_meteo(parms meteo_input_parms)
    returns setof errors_catalog
    language plpgsql
    as $body$ 
    begin
        return query
        with error_checks as (
            select 1 as error_id, (parms.equipment_type is null or parms.equipment_type not in ('ДМК', 'ВР')) as has_error
            union all select 2, (parms.height is null or parms.height != trunc(parms.height))
            union all select 3, (parms.temperature is null or parms.temperature < -58 or parms.temperature > 58)
            union all select 4, (parms.pressure is null or parms.pressure < 500 or parms.pressure > 900)
            union all select 5, (parms.wind_dir is null or parms.wind_dir < 0 or parms.wind_dir > 59 or parms.wind_dir != trunc(parms.wind_dir))
            union all select 6, (parms.equipment_type = 'ДМК' and (parms.wind_speed is null or parms.wind_speed < 0 or parms.wind_speed > 15 or parms.wind_speed != trunc(parms.wind_speed)))
            union all select 7, (parms.equipment_type = 'ВР' and (parms.bullet_drift is null or parms.bullet_drift < 0 or parms.bullet_drift > 150 or parms.bullet_drift != trunc(parms.bullet_drift)))
        )
        select ec.id, ec.name, ec.description
        from error_checks ech
        join errors_catalog ec on ec.id = ech.error_id
        where ech.has_error;
    end;
    $body$;
		
   end;

    -- Таблица констант
    drop table if exists meteo_constants cascade;
    drop sequence if exists meteo_constants_seq cascade;
    
    create sequence meteo_constants_seq start with 1;

    create table meteo_constants (
        id integer default nextval('meteo_constants_seq') not null,
        name character varying(50) unique not null,
        const_value numeric not null,
        description text,
        constraint pk_meteo_constants primary key (id)
    );

    alter sequence meteo_constants_seq owned by meteo_constants.id;

    -- Вспомогательная функция для чтения констант
    create or replace function get_meteo_constant(p_name text)
    returns numeric
    language plpgsql
    as $body$
    declare
        v_val numeric;
    begin
        select const_value into v_val 
        from meteo_constants 
        where name = p_name;
        
        if v_val is null then
            raise exception 'Константа "%" не найдена в таблице meteo_constants', p_name;
        end if;
        
        return v_val;
    end;
    $body$;

    -- Заполнение таблицы констант
    insert into meteo_constants(name, const_value, description) values
    ('base_pressure', 750, 'Табличное значение наземного давления'),
    ('base_virtual_temperature', 15.9, 'Табличное значение приземной температуры'),
    ('negative_pressure', 500, 'Код для отрицательного отклонения давления'),
    ('negative_temperature', 50, 'Код для отрицательного отклонения температуры')
    on conflict (name) do nothing; 

    -- Функция БББТТ
    create or replace function fn_meteo_bbbt(p_pressure numeric, p_temp numeric)
    returns text language plpgsql as $body$
    declare
        v_bbb text;
        v_tt text;
        v_delta_p numeric;
        v_virtual_correction numeric;
        v_delta_t numeric;
    begin
        -- расчет ббб (давление)
        v_delta_p := p_pressure - get_meteo_constant('base_pressure');
        if v_delta_p >= 0 then
            v_bbb := lpad(v_delta_p::text, 3, '0');
        else
            v_bbb := (get_meteo_constant('negative_pressure') - v_delta_p)::text;
        end if;

        -- расчет тт (температура)
        v_virtual_correction := calc_interpolated(p_temp, get_interpolation(p_temp));
        v_delta_t := round(p_temp + v_virtual_correction - get_meteo_constant('base_virtual_temperature'));
        
        if v_delta_t >= 0 then
            v_tt := lpad(v_delta_t::text, 2, '0');
        else
            v_tt := (get_meteo_constant('negative_temperature') - v_delta_t)::text;
        end if;

        return v_bbb || v_tt;
    end; $body$;

    -- ВВВВ
    create or replace function fn_meteo_vvvv(p_height numeric) returns text language sql as $body$
        select case 
            when p_height < 0 then '-' || lpad(abs(round(p_height))::text, 3, '0')
            else lpad(round(p_height)::text, 4, '0')
        end;
    $body$;

    -- ДДЧЧМ
    create or replace function fn_meteo_ddchchm(p_time timestamp) returns text language sql as $body$
        select to_char(p_time, 'ddhh24') || floor(extract(minute from p_time) / 10)::text;
    $body$;

    -- Полный заголовок
    create or replace function fn_meteo_header(
        p_time timestamp,
        p_height numeric,
        p_pressure numeric,
        p_temp numeric
    )
    returns text language sql as $body$
        select fn_meteo_ddchchm(p_time) || ' ' || fn_meteo_vvvv(p_height) || ' ' || fn_meteo_bbbt(p_pressure, p_temp);
    $body$;
    
end $$;