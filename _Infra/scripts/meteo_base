do $$
begin
    alter table measurment_input_params 
    add column if not exists error_message text;

-- Список параметров
	drop type if exists meteo_input_parms cascade;
	create type meteo_input_parms as (
		equipment_type text,  
		height numeric,       
		temperature numeric,
		pressure numeric,
		wind_dir numeric,
		wind_speed numeric,
		bullet_drift numeric
	);

-- Функция проверки
	create or replace function fn_validate_meteo(parms meteo_input_parms)
	returns text
	language plpgsql
	as $body$ 
	declare v_errors text := '';
	begin
		if parms.height != trunce(parms.height) then
			v_errors := v_errors or 'Высота должна быть целым числом';
		end if;

		if parms.temperature < -58 or parms.temperature > 58 then 
			v_errors := v_errors or 'Температура должна быть от -58 до 58';
		end if;

		if parms.pressure < 500 or parms.pressure > 900 then
			v_errors := v_errors or 'Давление должно быть от 500 до 900';
		end if;

		if parms.wind_dir < 0 or parms.wind_dir > 59 or parms.wind_dir != trunce(parms.wind_dir) then
			v_errors := v_errors or 'Направление ветра должно быть целым числом от 0 до 59';
		end if;

		if parms.equipment_type = 'ДМК' then
			if parms.wind_speed < 0 or parms.wind_speed > 15 or parms.wind_speed != trunce(parms.wind_speed) then
				v_errors := v_errors or 'Скорость ветра должно быть целым числом от 0 до 15';
			end if;
			
		elsif parms.equipment_type = 'ВР' then
			if parms.bullet_drift < 0 or parms.bullet_drift > 150 or parms.bullet_drift != trunce(parms.bullet_drift) then
				v_errors := v_errors or 'Дальность сноса пуль должна быть целым числом от 0 до 150';
			end if;
		else 
			v_errors := v_errors or 'Неизветный тип оборудывания';
			end if;

		if v_errors = '' then
			return null;
		end if;
		
		return trim(v_errors);
	end;
	$body$;
	
end $$;